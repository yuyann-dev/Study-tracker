# 降权版主服务（admin-checklist 5.4）——仅备用，部署时谨慎启用，不自动替换现网 root 版。
#
# 【启用前必做（在服务器上手动执行，本仓库不会自动跑）】
#   sudo useradd -r -s /usr/sbin/nologin study
#   sudo chown -R study:study /opt/study-tracker
#   # 让 study 对 .env / data / uploads / scripts 有读写权限
#   sudo chmod 600 /opt/study-tracker/backend/.env
#
# 【切换步骤】
#   sudo cp /opt/study-tracker/backend/scripts/study-tracker.service.study /etc/systemd/system/study-tracker.service
#   sudo systemctl daemon-reload && sudo systemctl restart study-tracker
#
# 现状：现网 deploy/study-tracker.service 是 User=root。切到 study 可把持有的 study.db /
# uploads / .env(含 JWT_SECRET 与 SMTP 授权码) 降到普通用户权限，最小化被攻破后的影响面。

[Unit]
Description=Study Tracker Backend API Server (non-root)
After=network.target

[Service]
Type=simple
User=study
Group=study
WorkingDirectory=/opt/study-tracker/backend
EnvironmentFile=/opt/study-tracker/backend/.env
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=study-tracker

[Install]
WantedBy=multi-user.target
