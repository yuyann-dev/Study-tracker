# 依赖
node_modules/

# 环境变量（含密钥，绝不提交）
.env
.env.local
!.env.example

# 数据库
backend/data/
*.db
*.db-journal
*.db-wal
*.db-shm

# 日志
backend/logs/
*.log
npm-debug.log*

# 上传文件
backend/uploads/

# 备份
backups/
*.bak
*.backup

# 预压缩文件（部署时生成）
*.gz

