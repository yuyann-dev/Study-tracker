# Study Tracker 环境变量配置
# 复制此文件为 .env 并填入实际值

# 服务端口
PORT=3001

# JWT 签名密钥（生产环境务必修改为随机字符串）
JWT_SECRET=your_jwt_secret_here

# SMTP 邮件配置（用于注册验证码、密码重置、告警）
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@qq.com
SMTP_PASS=your_smtp_auth_code
SMTP_FROM=Study Tracker <your_email@qq.com>

# 前端站点 URL（用于邮件里的重置链接）
APP_URL=https://your-domain.com
